# Development settings for your agent: copy to .env (ignored by git and docker build).
# The image must not need this file: put the values it runs with in the Dockerfile as ENV, and
# hand over <team>.env at code freeze (README: Code-freeze handover). KEY=VALUE, no quotes.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional loop settings (defaults in src/agentic_cad/config.py)
# AGENT_MAX_ITERS=6          # LLM attempts per test case
# AGENT_WORKERS=3            # test cases processed at the same time
# AGENT_TIME_BUDGET_S=1020   # wall clock for the whole run (hard limit: 20 min)
# AGENT_USE_IMAGES=1         # 0 for a text-only model
# AGENT_FEEDBACK_IMAGES=1    # 0 to send only the numeric feedback
